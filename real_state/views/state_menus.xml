<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Menú raíz solo para managers -->
    <menuitem 
        id="menu_real_estate_root" 
        name="Inmobiliaria" 
        sequence="1"
        groups="state_group_manager"/>

    <!-- Submenú de Propiedades solo para managers -->
    <menuitem 
        id="menu_real_estate_properties" 
        name="Propiedades" 
        parent="menu_real_estate_root" 
        action="action_state_property"
        sequence="10"
        groups="state_group_manager"/>

    <!-- Submenú de Ofertas solo para managers -->
    <menuitem 
        id="menu_real_estate_offers" 
        name="Ofertas" 
        parent="menu_real_estate_root" 
        action="action_state_ofert"
        sequence="20"
        groups="state_group_manager"/>


    <!-- Acción para abrir managers -->
    <record id="action_state_manager" model="ir.actions.act_window">
        <field name="name">Managers</field>
        <field name="res_model">state_manager</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un manager inmobiliario para gestionar agentes y propiedades.
            </p>
        </field>
    </record>

    <!-- Accion de formulario property -->
    <record id="action_state_form_property" model="ir.actions.act_window">
        <field name="name">form_property</field>
        <field name="type">ir.action.act_window</field>
        <field name="res_model">state_property</field>
        <field name="view_mode">form</field>
    </record>


    <!-- Accion form del manager -->
    <record id="action_form_state_manager" model="ir.actions.act_window">
    <field name="name">Managers forms</field>
    <field name="res_model">state_manager</field>
    <field name="view_mode">form</field>
    </record>

    <!-- Accion list del manager -->
    <record id="action_list_state_manager" model="ir.actions.act_window">
    <field name="name">Managers list </field>
    <field name="res_model">state_manager</field>
    <field name="view_mode">list</field>
    </record>
</odoo>